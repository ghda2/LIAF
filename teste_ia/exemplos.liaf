(module exemplos
  (struct Usuario
    (fields
      (id int)
      (nome str)
      (email str)))

  (fn somar (params (a int) (b int)) (returns int) (effects)
    (body
      (return (add a b))))

  (fn criar-tabela (params (db DBConnection)) (returns (result bool str)) (effects db)
    (body
      (try (db-exec db "CREATE TABLE IF NOT EXISTS usuarios (id int PRIMARY KEY, nome text, email text)"))
      (return (ok true))))

  (fn cadastrar (params (db DBConnection) (id int) (nome str) (email str)) (returns (result bool str)) (effects db)
    (body
      (try (db-exec db "INSERT INTO usuarios (id, nome, email) VALUES ($1, $2, $3)" id nome email))
      (return (ok true))))

  (fn buscar-todos (params (db DBConnection)) (returns (result (list Usuario) str)) (effects db)
    (body
      (let lista (list Usuario) (try (db-query db "SELECT id, nome, email FROM usuarios" Usuario)))
      (return (ok lista))))

  (fn executar (params (db DBConnection)) (returns (result bool str)) (effects db io)
    (body
      (try (criar-tabela db))
      (println "Tabela pronta")
      (return (ok true))))

  (fn main (params) (returns void) (effects io db)
    (body
      (match (db-connect "postgres" "postgres://user:pass@localhost:5432/app")
        (ok db
          (match (executar db)
            (ok r (println "Sucesso"))
            (err msg (println msg))))
        (err msg
          (println (concat "Erro de conexao: " msg)))))))
