// Autenticação por cookie de sessão (HttpOnly, Secure, SameSite).
module auth_cookies_exemplo

import "std/auth"
import "std/cookie"

struct LoginInput
  usuario str
  senha str
end

struct Status
  status str
end

struct Perfil
  usuario str
  sessao str
end

// Em produção, o hash vem do banco e as sessões ficam num store (banco ou Redis).
route POST "/login" (input LoginInput) Response effects(rand)
  on-err msg
    json-error(500, msg)
  end
  let hash = try auth-hash-password("senha-de-exemplo")
  let usuario_ok = secure-eq(input.usuario, "admin")
  if !usuario_ok || !auth-verify-password(input.senha, hash)
    return json-error(401, "credenciais invalidas")
  end
  let sid = random-token()
  let c = cookie-make("sid", sid, 86400, "/", true, true, "Lax")
  response-set-cookie(json-response(200, try json-encode(new Status("logado"))), c)
end

route GET "/perfil" (req Request) Response
  on-err _
    json-error(401, "nao autenticado")
  end
  let sid = try auth-cookie(req, "sid")
  json-response(200, try json-encode(new Perfil("admin", sid)))
end

route POST "/logout" () Response
  on-err msg
    json-error(500, msg)
  end
  response-delete-cookie(json-response(200, try json-encode(new Status("deslogado"))), "sid", "/")
end

fn main() void effects(fs, io, net)
  println("Servidor de autenticação rodando na porta 8080")
  unwrap-or(serve-hybrid("./public", "8080"), false)
end
