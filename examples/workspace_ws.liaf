;; LIAF Collab Workspace (Kanban + Docs Markdown + WebSockets + SQLite)
;; Linguagem LIAF v0.4 - Demonstração Completa de Recursos
(module workspace-ws
  (struct Card (fields (id int) (title str) (column str) (author str)))
  (struct BoardResponse (fields (cards (list Card))))
  (struct CreateCardInput (fields (title str) (column str) (author str)))
  (struct MoveCardInput (fields (column str)))

  (struct DocItem (fields (id int) (slug str) (title str) (content str) (author str) (updated_at str)))
  (struct DocsResponse (fields (docs (list DocItem))))
  (struct CreateDocInput (fields (slug str) (title str) (content str) (author str) (updated_at str)))
  (struct UpdateDocInput (fields (title str) (content str) (updated_at str)))

  (struct ApiError (fields (error str)))
  (struct WsEvent (fields (kind str) (message str)))

  (fn error-response (params (status int) (message str)) (returns Response) (effects)
    (on-err fail (return (json-response 500 "{\"error\":\"Falha de serializacao\"}")))
    (body
      (let payload str (try (json-encode (new ApiError message))))
      (return (json-response status payload))))

  (fn event-json (params (kind str) (message str)) (returns str) (effects)
    (on-err message (return "{\"kind\":\"error\",\"message\":\"serialization failure\"}"))
    (body
      (let payload str (try (json-encode (new WsEvent kind message))))
      (return payload)))

  (fn notify-clients (params (kind str) (action str)) (returns void) (effects net)
    (on-err err (return))
    (body
      (try (ws-broadcast "workspace" (event-json kind action)))
      (return)))

  (fn get-db (params) (returns (result DBConnection str)) (effects db)
    (body
      (let db DBConnection (try (db-connect "sqlite" "kanban.db")))
      (return (ok db))))

  (fn init-db (params) (returns (result bool str)) (effects db)
    (body
      (let db DBConnection (try (get-db)))
      (try (db-exec db "CREATE TABLE IF NOT EXISTS cards (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL, column TEXT NOT NULL, author TEXT NOT NULL)"))
      (try (db-exec db "CREATE TABLE IF NOT EXISTS documents (id INTEGER PRIMARY KEY AUTOINCREMENT, slug TEXT UNIQUE NOT NULL, title TEXT NOT NULL, content TEXT NOT NULL, author TEXT NOT NULL, updated_at TEXT NOT NULL)"))

      ;; Popula cards padrao caso tabela esteja vazia
      (let existing-cards (list Card) (try (db-query db "SELECT id, title, column, author FROM cards LIMIT 1" Card)))
      (if (eq (list-len existing-cards) 0)
        (then
          (try (db-exec db "INSERT INTO cards (title, column, author) VALUES (?, ?, ?)" "Conectar SQLite e WebSockets" "done" "Gabriel"))
          (try (db-exec db "INSERT INTO cards (title, column, author) VALUES (?, ?, ?)" "Editor Markdown Colaborativo" "in_progress" "LIAF AI"))
          (try (db-exec db "INSERT INTO cards (title, column, author) VALUES (?, ?, ?)" "Deploy em Produção (tw.webdrop.bio)" "todo" "DevOps"))))

      ;; Popula docs padrao caso tabela esteja vazia
      (let existing-docs (list DocItem) (try (db-query db "SELECT id, slug, title, content, author, updated_at FROM documents LIMIT 1" DocItem)))
      (if (eq (list-len existing-docs) 0)
        (then
          (try (db-exec db "INSERT INTO documents (slug, title, content, author, updated_at) VALUES (?, ?, ?, ?, ?)" "bem-vindo" "Bem-vindo ao LIAF Workspace" "# LIAF Live Workspace\n\nEste documento foi carregado nativamente do **SQLite** e renderizado em tempo real.\n\n### Recursos Ativos:\n- **LIAF v0.4** compilado em binário nativo\n- **WebSockets** para colaboração instantânea\n- **Banco de Dados SQLite** para persistência atômica" "Gabriel" "Hoje"))))

      (return (ok true))))

  (fn load-cards (params) (returns (result (list Card) str)) (effects db)
    (body
      (let db DBConnection (try (get-db)))
      (let cards (list Card) (try (db-query db "SELECT id, title, column, author FROM cards ORDER BY id" Card)))
      (return (ok cards))))

  (fn load-docs (params) (returns (result (list DocItem) str)) (effects db)
    (body
      (let db DBConnection (try (get-db)))
      (let docs (list DocItem) (try (db-query db "SELECT id, slug, title, content, author, updated_at FROM documents ORDER BY id DESC" DocItem)))
      (return (ok docs))))

  ;; --- Rotas HTTP REST para Cards ---
  (route GET "/api/board" (params) (returns Response) (effects db)
    (on-err message (return (error-response 500 message)))
    (body
      (let cards (list Card) (try (load-cards)))
      (let payload str (try (json-encode (new BoardResponse cards))))
      (return (json-response 200 payload))))

  (route POST "/api/cards" (params (input CreateCardInput)) (returns Response) (effects db net)
    (on-err message (return (error-response 500 message)))
    (body
      (if (str-eq (field input title) "")
        (then (return (error-response 400 "Título obrigatório"))))
      (let col str (field input column))
      (if (str-eq col "") (then (set col "todo")))
      (let author str (field input author))
      (if (str-eq author "") (then (set author "Anônimo")))
      (let db DBConnection (try (get-db)))
      (try (db-exec db "INSERT INTO cards (title, column, author) VALUES (?, ?, ?)" (field input title) col author))
      (do (notify-clients "sync" (concat "Card criado: " (field input title))))
      (return (json-response 201 "{\"ok\":true}"))))

  (route PUT "/api/cards/{id}/move" (params (id int) (input MoveCardInput)) (returns Response) (effects db net)
    (on-err message (return (error-response 500 message)))
    (body
      (if (lte id 0)
        (then (return (error-response 400 "ID inválido"))))
      (let db DBConnection (try (get-db)))
      (try (db-exec db "UPDATE cards SET column = ? WHERE id = ?" (field input column) id))
      (do (notify-clients "sync" (concat "Card movido para " (field input column))))
      (return (json-response 200 "{\"ok\":true}"))))

  (route DELETE "/api/cards/{id}" (params (id int)) (returns Response) (effects db net)
    (on-err message (return (error-response 500 message)))
    (body
      (if (lte id 0)
        (then (return (error-response 400 "ID inválido"))))
      (let db DBConnection (try (get-db)))
      (try (db-exec db "DELETE FROM cards WHERE id = ?" id))
      (do (notify-clients "sync" "Card excluído"))
      (return (json-response 200 "{\"ok\":true}"))))

  ;; --- Rotas HTTP REST para Docs (Markdown) ---
  (route GET "/api/docs" (params) (returns Response) (effects db)
    (on-err message (return (error-response 500 message)))
    (body
      (let docs (list DocItem) (try (load-docs)))
      (let payload str (try (json-encode (new DocsResponse docs))))
      (return (json-response 200 payload))))

  (route POST "/api/docs" (params (input CreateDocInput)) (returns Response) (effects db net)
    (on-err message (return (error-response 500 message)))
    (body
      (if (str-eq (field input title) "")
        (then (return (error-response 400 "Título obrigatório"))))
      (let author str (field input author))
      (if (str-eq author "") (then (set author "Anônimo")))
      (let db DBConnection (try (get-db)))
      (try (db-exec db "INSERT INTO documents (slug, title, content, author, updated_at) VALUES (?, ?, ?, ?, ?)" (field input slug) (field input title) (field input content) author (field input updated_at)))
      (do (notify-clients "doc_sync" (concat "Documento criado: " (field input title))))
      (return (json-response 201 "{\"ok\":true}"))))

  (route PUT "/api/docs/{id}" (params (id int) (input UpdateDocInput)) (returns Response) (effects db net)
    (on-err message (return (error-response 500 message)))
    (body
      (if (lte id 0)
        (then (return (error-response 400 "ID inválido"))))
      (let db DBConnection (try (get-db)))
      (try (db-exec db "UPDATE documents SET title = ?, content = ?, updated_at = ? WHERE id = ?" (field input title) (field input content) (field input updated_at) id))
      (do (notify-clients "doc_sync" (concat "Documento atualizado: " (field input title))))
      (return (json-response 200 "{\"ok\":true}"))))

  (route DELETE "/api/docs/{id}" (params (id int)) (returns Response) (effects db net)
    (on-err message (return (error-response 500 message)))
    (body
      (if (lte id 0)
        (then (return (error-response 400 "ID inválido"))))
      (let db DBConnection (try (get-db)))
      (try (db-exec db "DELETE FROM documents WHERE id = ?" id))
      (do (notify-clients "doc_sync" "Documento excluído"))
      (return (json-response 200 "{\"ok\":true}"))))

  ;; Estatísticas / Presença
  (route GET "/api/collaborators" (params) (returns Response) (effects net)
    (body
      (return (json-response 200
        (concat "{\"online\":" (str-from-int (ws-topic-size "workspace")) "}")))))

  ;; --- Rota WebSocket para Sincronização em Tempo Real ---
  (ws-route "/ws/board" (params (conn WSConn)) (effects io net)
    (on-err message (println (concat "workspace ws err: " message)))
    (on-open
      (ws-join conn "workspace")
      (println "Colaborador conectado ao Workspace")
      (try (ws-broadcast "workspace" (event-json "presence" "Um colaborador conectou-se"))))
    (on-message text
      (try (ws-broadcast "workspace" (event-json "sync" text))))
    (on-close
      (println "Colaborador desconectado")
      (try (ws-broadcast "workspace" (event-json "presence" "Um colaborador desconectou-se")))))

  (fn main (params) (returns void) (effects db fs io net)
    (body
      (match (init-db)
        (ok inited (println "Banco SQLite inicializado com sucesso"))
        (err err (println (concat "Falha ao inicializar SQLite: " err))))
      (let port str "7070")
      (match (list-get (args) 0)
        (ok p (set port p))
        (err ignored (set port "7070")))
      (println (concat "LIAF Collab Workspace rodando na porta " port))
      (match (serve-hybrid "./public" port)
        (ok stopped (println "Servidor parado"))
        (err message (println message)))))
)
