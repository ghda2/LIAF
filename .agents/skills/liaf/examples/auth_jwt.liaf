// Exemplo de Autenticação JWT, Hash de Senhas e Rotas Protegidas
module auth_jwt_exemplo

import "std/auth"
import "std/jwt"

pub struct LoginInput
  email str
  senha str
end

pub struct UsuarioClaims
  sub str
  role str
  exp int
end

pub struct TokenResposta
  token str
  tipo str
end

// Chave secreta de no mínimo 32 bytes
fn segredo_jwt() str
  "chave-super-secreta-militar-32-bytes!"
end

// Rota de Login (Gera Token JWT)
route POST "/api/login" (input LoginInput) Response effects(clock, rand)
  on-err msg
    json-error(400, msg)
  end

  // Exemplo de verificação de senha com Argon2id
  let hash_esperado = try auth-hash-password("senha123")
  if not(auth-verify-password(input.senha, hash_esperado))
    return json-error(401, "Credenciais inválidas")
  end

  // Expiração em 24h (agora em ms convertido para segundos + 86400)
  let agora_seg = try (now-ms() / 1000)
  let expira = agora_seg + 86400

  let claims = new UsuarioClaims(input.email, "admin", expira)
  let payload_json = try json-encode(claims)
  let token = try jwt-sign(segredo_jwt(), payload_json)

  let resp = new TokenResposta(token, "Bearer")
  json-response(200, try json-encode(resp))
end

// Rota Protegida (Guarda Declarativa de Autenticação)
route GET "/api/painel" (req Request) Response effects(clock, io)
  on-err msg
    json-error(401, msg)
  end

  // auth-guard-jwt valida o token Bearer e devolve o payload JSON (ou falha com erro 401)
  let payload = try auth-guard-jwt(req, segredo_jwt())
  let claims = try json-decode(payload, UsuarioClaims)

  println(fmt("Acesso autorizado para usuário: {}", claims.sub))
  json-response(200, fmt("{{\"mensagem\":\"Bem-vindo {}\",\"role\":\"{}\"}}", claims.sub, claims.role))
end

fn main() void effects(fs, io, net)
  println("Servidor de autenticação rodando em http://localhost:8080")
  let _ = serve-hybrid("./public", "8080")
end
