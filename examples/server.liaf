# Servidor HTTP Nativo em LIAF (Zero dependencias externas)

[fn handle_request (path: str) -> (str)
  (println (concat "Requisicao recebida na rota: " path))
  [return (concat "{\"status\": 200, \"message\": \"LIAF HTTP Server Ativo!\", \"path\": \"" path "\"}")]
/fn handle_request]

[fn main () -> (void)
  (println "========================================")
  (println "  Servidor LIAF rodando em :8080")
  (println "========================================")
  (http_serve ":8080" handle_request)
/fn main]
