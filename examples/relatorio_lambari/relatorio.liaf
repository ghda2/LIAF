// Relatório de Temperaturas de Lambari - MG
// Gera relatorio_lambari.pdf e relatorio_lambari.png a partir do template Typst

module relatorio_lambari

struct RegistroDiario
  data str
  dia_semana str
  temp_min int
  temp_max int
  umidade int
  condicao str
end

struct RelatorioLambari
  cidade str
  estado str
  estacao str
  periodo str
  gerado_em str
  temp_media str
  precipitacao_total str
  resumo str
  registros (list RegistroDiario)
  cor_tema str
end

fn dados_lambari() RelatorioLambari
  let regs = make-list(RegistroDiario)
  list-push(regs, new RegistroDiario("24/09", "Qui", 14, 26, 65, "Ensolarado"))
  list-push(regs, new RegistroDiario("25/09", "Sex", 15, 27, 62, "Ensolarado"))
  list-push(regs, new RegistroDiario("26/09", "Sáb", 16, 28, 58, "Céu limpo"))
  list-push(regs, new RegistroDiario("27/09", "Dom", 17, 28, 68, "Parcialmente nublado"))
  list-push(regs, new RegistroDiario("28/09", "Seg", 16, 25, 75, "Chuva isolada"))
  list-push(regs, new RegistroDiario("29/09", "Ter", 15, 23, 82, "Pancadas de chuva"))
  list-push(regs, new RegistroDiario("30/09", "Qua", 14, 24, 70, "Estável"))

  new RelatorioLambari(
    "Lambari",
    "MG",
    "Estação Hidromineral do Parque das Águas",
    "24/09/2026 a 30/09/2026",
    "30/09/2026 às 19:24",
    "21,6°C",
    "18 mm",
    "Semana de transição para a primavera no Sul de Minas: manhãs frescas típicas da Mantiqueira, tardes amenas e pancadas passageiras de chuva.",
    regs,
    "#0369a1"
  )
end

fn main() void effects(fs, io)
  on-err e
    println(fmt("erro ao gerar relatório: {}", e))
    exit(1)
  end

  let layout = try fs-read-file("relatorio.typ")
  let json_dados = try json-encode(dados_lambari())

  let pdf = try pdf-typst(layout, json_dados)
  try fs-write-file("relatorio_lambari.pdf", pdf)

  let png = try png-typst(layout, json_dados)
  try fs-write-file("relatorio_lambari.png", png)

  println(fmt("Sucesso: relatorio_lambari.pdf gerado ({} bytes)", str-byte-len(pdf)))
  println(fmt("Prévia: relatorio_lambari.png gerada ({} bytes)", str-byte-len(png)))
end
