;; std/jwt - JSON Web Token com HS256 (HMAC-SHA256).
;;
;;   (import "std/jwt")
;;   (let token str (try (jwt-sign segredo (try (json-encode (new Sessao "ana" expira))))))
;;   (let payload str (try (jwt-verify segredo token)))
;;   (let sessao Sessao (try (json-decode payload Sessao)))
;;
;; O payload e JSON montado pelo programa, com o struct que ele quiser; a
;; unica exigencia e o campo exp (segundos desde 1970). jwt-verify recusa
;; token sem exp: um token que nunca expira e uma senha que nao da para
;; trocar.
;;
;; So HS256. O cabecalho e fixo na assinatura e conferido na verificacao, o
;; que fecha o ataque classico de trocar alg para "none".
;;
;; O segredo precisa ter pelo menos 32 bytes (RFC 7518, 3.2: a chave do HS256
;; nao pode ser menor que o hash). Sign e verify recusam segredo curto, entao
;; uma variavel de ambiente que faltou vira erro, e nao um token assinado com
;; "" que qualquer um consegue forjar.
(module jwt
  (struct JwtHeader (fields (alg str) (typ str)))
  (struct JwtExp (fields (exp int)))

  (fn jwt-segredo-valido (params (segredo str)) (returns (result str str)) (effects)
    (body
      (if (lt (str-byte-len segredo) 32)
        (then (return (err "jwt: secret must have at least 32 bytes"))))
      (return (ok segredo))))

  (fn jwt-sign (params (segredo str) (payload str)) (returns (result str str)) (effects)
    (body
      (try (jwt-segredo-valido segredo))
      (let dados str (concat (base64url-encode "{\"alg\":\"HS256\",\"typ\":\"JWT\"}") "." (base64url-encode payload)))
      (return (ok (concat dados "." (hmac-sha256 segredo dados "base64url"))))))

  ;; Devolve o payload (JSON) de um token valido e dentro da validade.
  (fn jwt-verify (params (segredo str) (token str)) (returns (result str str)) (effects clock)
    (body
      (try (jwt-segredo-valido segredo))
      (let partes (list str) (str-split token "."))
      (if (neq (list-len partes) 3)
        (then (return (err "jwt: malformed token"))))
      (let cabecalho str (try (list-get partes 0)))
      (let corpo str (try (list-get partes 1)))
      (let assinatura str (try (list-get partes 2)))

      ;; A assinatura vem antes de qualquer parse: nada do que o cliente
      ;; mandou e interpretado antes de provar que veio de quem tem o segredo.
      (let esperada str (hmac-sha256 segredo (concat cabecalho "." corpo) "base64url"))
      (if (not (secure-eq assinatura esperada))
        (then (return (err "jwt: invalid signature"))))

      (let header JwtHeader (try (json-decode (try (base64url-decode cabecalho)) JwtHeader)))
      (if (not (str-eq (field header alg) "HS256"))
        (then (return (err "jwt: unsupported alg"))))

      (let payload str (try (base64url-decode corpo)))
      (let claims JwtExp (try (json-decode payload JwtExp)))
      (if (lte (field claims exp) 0)
        (then (return (err "jwt: missing exp claim"))))
      (let agora int (try (div (now-ms) 1000)))
      (if (lte (field claims exp) agora)
        (then (return (err "jwt: token expired"))))
      (return (ok payload))))
)
