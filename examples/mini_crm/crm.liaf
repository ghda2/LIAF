;; LIAF Enterprise CRM v0.4
;; Gestão Comercial Completa: Leads, Pipeline, Atividades, Produtos e Analytics
(module enterprise-crm
  ;; --- Entidades de Dados ---
  (struct Lead (fields (id int) (name str) (company str) (email str) (phone str) (stage str) (value int) (priority str) (notes str) (created_at str)))
  (struct LeadsResponse (fields (leads (list Lead))))
  (struct CreateLeadInput (fields (name str) (company str) (email str) (phone str) (stage str) (value int) (priority str) (notes str) (created_at str)))
  (struct MoveStageInput (fields (stage str)))
  (struct UpdateLeadInput (fields (name str) (company str) (email str) (phone str) (value int) (priority str) (notes str)))

  (struct Activity (fields (id int) (deal_id int) (kind str) (description str) (author str) (created_at str)))
  (struct ActivitiesResponse (fields (activities (list Activity))))
  (struct CreateActivityInput (fields (deal_id int) (kind str) (description str) (author str) (created_at str)))

  (struct Product (fields (id int) (name str) (sku str) (price int) (category str)))
  (struct ProductsResponse (fields (products (list Product))))
  (struct CreateProductInput (fields (name str) (sku str) (price int) (category str)))

  (struct StatsSummary (fields (pipeline_value int) (won_value int) (total_deals int) (won_deals int) (active_deals int) (avg_ticket int)))

  (struct ApiError (fields (error str)))
  (struct WsEvent (fields (kind str) (message str)))

  ;; --- Helpers de Resposta e Notificação ---
  (fn error-response (params (status int) (message str)) (returns Response) (effects)
    (on-err fail (return (json-response 500 "{\"error\":\"Falha de serializacao\"}")))
    (body
      (let payload str (try (json-encode (new ApiError message))))
      (return (json-response status payload))))

  (fn event-json (params (kind str) (message str)) (returns str) (effects)
    (on-err message (return "{\"kind\":\"error\",\"message\":\"serialization failure\"}"))
    (body
      (let payload str (try (json-encode (new WsEvent kind message))))
      (return payload)))

  (fn notify-crm (params (kind str) (action str)) (returns void) (effects net)
    (on-err err (return))
    (body
      (try (ws-broadcast "crm" (event-json kind action)))
      (return)))

  ;; --- Conexão e Inicialização do Banco SQLite ---
  (fn get-db (params) (returns (result DBConnection str)) (effects db)
    (body
      (let db DBConnection (try (db-connect "sqlite" "crm.db")))
      (return (ok db))))

  (fn init-db (params) (returns (result bool str)) (effects db)
    (body
      (let db DBConnection (try (get-db)))
      (try (db-exec db "CREATE TABLE IF NOT EXISTS leads (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, company TEXT NOT NULL, email TEXT NOT NULL, phone TEXT NOT NULL, stage TEXT NOT NULL, value INTEGER NOT NULL, priority TEXT NOT NULL, notes TEXT NOT NULL, created_at TEXT NOT NULL)"))
      (try (db-exec db "CREATE TABLE IF NOT EXISTS activities (id INTEGER PRIMARY KEY AUTOINCREMENT, deal_id INTEGER NOT NULL, kind TEXT NOT NULL, description TEXT NOT NULL, author TEXT NOT NULL, created_at TEXT NOT NULL)"))
      (try (db-exec db "CREATE TABLE IF NOT EXISTS products (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, sku TEXT NOT NULL, price INTEGER NOT NULL, category TEXT NOT NULL)"))

      ;; Seed de leads de demonstração
      (let existing-leads (list Lead) (try (db-query db "SELECT id, name, company, email, phone, stage, value, priority, notes, created_at FROM leads LIMIT 1" Lead)))
      (if (eq (list-len existing-leads) 0)
        (then
          (try (db-exec db "INSERT INTO leads (name, company, email, phone, stage, value, priority, notes, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)" "Ana Souza" "TechCorp Brasil" "ana@techcorp.com.br" "(11) 98765-4321" "prospect" 18500 "high" "Interessada na migração de microsserviços para LIAF" "14/09/2026"))
          (try (db-exec db "INSERT INTO leads (name, company, email, phone, stage, value, priority, notes, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)" "Carlos Lima" "Inovação Digital" "carlos@inovacao.io" "(21) 99887-1122" "proposal" 34000 "medium" "Proposta enviada para plataforma em tempo real" "15/09/2026"))
          (try (db-exec db "INSERT INTO leads (name, company, email, phone, stage, value, priority, notes, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)" "Mariana Rios" "Global Logística" "mariana@globallog.com" "(31) 97654-3344" "won" 52000 "high" "Contrato corporativo anual assinado" "16/09/2026"))
          (try (db-exec db "INSERT INTO leads (name, company, email, phone, stage, value, priority, notes, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)" "Roberto Dias" "Alfa Seguros" "roberto@alfaseguros.com" "(41) 98877-6655" "negotiation" 27000 "medium" "Ajustando termos de SLA e suporte 24/7" "17/09/2026"))))

      ;; Seed de atividades iniciais
      (let existing-act (list Activity) (try (db-query db "SELECT id, deal_id, kind, description, author, created_at FROM activities LIMIT 1" Activity)))
      (if (eq (list-len existing-act) 0)
        (then
          (try (db-exec db "INSERT INTO activities (deal_id, kind, description, author, created_at) VALUES (?, ?, ?, ?, ?)" 1 "call" "Alinhamento inicial de requisitos técnicos com a CTO" "Gabriel" "14/09 14:30"))
          (try (db-exec db "INSERT INTO activities (deal_id, kind, description, author, created_at) VALUES (?, ?, ?, ?, ?)" 2 "meeting" "Apresentação da demonstração do LIAF Web Engine e SQLite" "Gabriel" "15/09 10:00"))
          (try (db-exec db "INSERT INTO activities (deal_id, kind, description, author, created_at) VALUES (?, ?, ?, ?, ?)" 3 "won" "Assinatura digital do contrato concluída com sucesso!" "Diretoria" "16/09 17:15"))))

      ;; Seed de produtos no catálogo
      (let existing-prod (list Product) (try (db-query db "SELECT id, name, sku, price, category FROM products LIMIT 1" Product)))
      (if (eq (list-len existing-prod) 0)
        (then
          (try (db-exec db "INSERT INTO products (name, sku, price, category) VALUES (?, ?, ?, ?)" "Licença LIAF Enterprise Core" "LIAF-ENT-01" 15000 "Software"))
          (try (db-exec db "INSERT INTO products (name, sku, price, category) VALUES (?, ?, ?, ?)" "Suporte e SLA 24/7 Anual" "LIAF-SUP-24" 12000 "Serviços"))
          (try (db-exec db "INSERT INTO products (name, sku, price, category) VALUES (?, ?, ?, ?)" "Consultoria de Implantação e IA" "LIAF-CNS-01" 8000 "Consultoria"))))

      (return (ok true))))

  ;; --- Funções de Leitura do Banco ---
  (fn load-leads (params) (returns (result (list Lead) str)) (effects db)
    (body
      (let db DBConnection (try (get-db)))
      (let leads (list Lead) (try (db-query db "SELECT id, name, company, email, phone, stage, value, priority, notes, created_at FROM leads ORDER BY id DESC" Lead)))
      (return (ok leads))))

  (fn load-activities (params (deal-id int)) (returns (result (list Activity) str)) (effects db)
    (body
      (let db DBConnection (try (get-db)))
      (let acts (list Activity) (try (db-query db "SELECT id, deal_id, kind, description, author, created_at FROM activities WHERE deal_id = ? ORDER BY id DESC" Activity deal-id)))
      (return (ok acts))))

  (fn load-products (params) (returns (result (list Product) str)) (effects db)
    (body
      (let db DBConnection (try (get-db)))
      (let prods (list Product) (try (db-query db "SELECT id, name, sku, price, category FROM products ORDER BY id ASC" Product)))
      (return (ok prods))))

  (fn calculate-stats (params (leads (list Lead))) (returns StatsSummary) (effects)
    (body
      (let pipe-val int 0)
      (let won-val int 0)
      (let total int (list-len leads))
      (let won-count int 0)
      (let active-count int 0)
      (for-each l leads
        (if (str-eq (field l stage) "won")
          (then
            (set won-val (add won-val (field l value)))
            (set won-count (add won-count 1)))
          (else
            (set pipe-val (add pipe-val (field l value)))
            (set active-count (add active-count 1)))))
      (let avg int 0)
      (if (gt total 0)
        (then (set avg (div (add pipe-val won-val) total))))
      (return (new StatsSummary pipe-val won-val total won-count active-count avg))))

  ;; --- Rotas REST API: Leads ---
  (route GET "/api/leads" (params) (returns Response) (effects db)
    (on-err message (return (error-response 500 message)))
    (body
      (let leads (list Lead) (try (load-leads)))
      (let payload str (try (json-encode (new LeadsResponse leads))))
      (return (json-response 200 payload))))

  (route POST "/api/leads" (params (input CreateLeadInput)) (returns Response) (effects db net)
    (on-err message (return (error-response 500 message)))
    (body
      (if (str-eq (field input name) "")
        (then (return (error-response 400 "Nome do contato é obrigatório"))))
      (let stage str (field input stage))
      (if (str-eq stage "") (then (set stage "prospect")))
      (let priority str (field input priority))
      (if (str-eq priority "") (then (set priority "medium")))
      (let db DBConnection (try (get-db)))
      (try (db-exec db "INSERT INTO leads (name, company, email, phone, stage, value, priority, notes, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)" (field input name) (field input company) (field input email) (field input phone) stage (field input value) priority (field input notes) (field input created_at)))
      (do (notify-crm "sync" (concat "Novo lead adicionado: " (field input name))))
      (return (json-response 201 "{\"ok\":true}"))))

  (route PUT "/api/leads/{id}/stage" (params (id int) (input MoveStageInput)) (returns Response) (effects db net)
    (on-err message (return (error-response 500 message)))
    (body
      (if (lte id 0)
        (then (return (error-response 400 "ID inválido"))))
      (let db DBConnection (try (get-db)))
      (try (db-exec db "UPDATE leads SET stage = ? WHERE id = ?" (field input stage) id))
      (do (notify-crm "sync" (concat "Lead movido para fase: " (field input stage))))
      (return (json-response 200 "{\"ok\":true}"))))

  (route PUT "/api/leads/{id}" (params (id int) (input UpdateLeadInput)) (returns Response) (effects db net)
    (on-err message (return (error-response 500 message)))
    (body
      (if (lte id 0)
        (then (return (error-response 400 "ID inválido"))))
      (let db DBConnection (try (get-db)))
      (try (db-exec db "UPDATE leads SET name = ?, company = ?, email = ?, phone = ?, value = ?, priority = ?, notes = ? WHERE id = ?" (field input name) (field input company) (field input email) (field input phone) (field input value) (field input priority) (field input notes) id))
      (do (notify-crm "sync" (concat "Lead atualizado: " (field input name))))
      (return (json-response 200 "{\"ok\":true}"))))

  (route DELETE "/api/leads/{id}" (params (id int)) (returns Response) (effects db net)
    (on-err message (return (error-response 500 message)))
    (body
      (if (lte id 0)
        (then (return (error-response 400 "ID inválido"))))
      (let db DBConnection (try (get-db)))
      (try (db-exec db "DELETE FROM leads WHERE id = ?" id))
      (try (db-exec db "DELETE FROM activities WHERE deal_id = ?" id))
      (do (notify-crm "sync" "Lead excluído"))
      (return (json-response 200 "{\"ok\":true}"))))

  ;; --- Rotas REST API: Atividades / Histórico ---
  (route GET "/api/leads/{id}/activities" (params (id int)) (returns Response) (effects db)
    (on-err message (return (error-response 500 message)))
    (body
      (if (lte id 0)
        (then (return (error-response 400 "ID inválido"))))
      (let acts (list Activity) (try (load-activities id)))
      (let payload str (try (json-encode (new ActivitiesResponse acts))))
      (return (json-response 200 payload))))

  (route POST "/api/activities" (params (input CreateActivityInput)) (returns Response) (effects db net)
    (on-err message (return (error-response 500 message)))
    (body
      (if (lte (field input deal_id) 0)
        (then (return (error-response 400 "ID do lead inválido"))))
      (let db DBConnection (try (get-db)))
      (try (db-exec db "INSERT INTO activities (deal_id, kind, description, author, created_at) VALUES (?, ?, ?, ?, ?)" (field input deal_id) (field input kind) (field input description) (field input author) (field input created_at)))
      (do (notify-crm "activity_sync" (concat "Nova atividade registrada: " (field input description))))
      (return (json-response 201 "{\"ok\":true}"))))

  ;; --- Rotas REST API: Produtos ---
  (route GET "/api/products" (params) (returns Response) (effects db)
    (on-err message (return (error-response 500 message)))
    (body
      (let prods (list Product) (try (load-products)))
      (let payload str (try (json-encode (new ProductsResponse prods))))
      (return (json-response 200 payload))))

  (route POST "/api/products" (params (input CreateProductInput)) (returns Response) (effects db)
    (on-err message (return (error-response 500 message)))
    (body
      (if (str-eq (field input name) "")
        (then (return (error-response 400 "Nome do produto é obrigatório"))))
      (let db DBConnection (try (get-db)))
      (try (db-exec db "INSERT INTO products (name, sku, price, category) VALUES (?, ?, ?, ?)" (field input name) (field input sku) (field input price) (field input category)))
      (return (json-response 201 "{\"ok\":true}"))))

  ;; --- Rotas REST API: Analytics & Presença ---
  (route GET "/api/crm/stats" (params) (returns Response) (effects db)
    (on-err message (return (error-response 500 message)))
    (body
      (let leads (list Lead) (try (load-leads)))
      (let stats StatsSummary (calculate-stats leads))
      (let payload str (try (json-encode stats)))
      (return (json-response 200 payload))))

  (route GET "/api/online" (params) (returns Response) (effects net)
    (body
      (return (json-response 200
        (concat "{\"online\":" (str-from-int (ws-topic-size "crm")) "}")))))

  ;; --- Rota WebSocket em Tempo Real ---
  (ws-route "/ws/crm" (params (conn WSConn)) (effects io net)
    (on-err message (println (concat "crm ws err: " message)))
    (on-open
      (ws-join conn "crm")
      (println "Vendedor conectado ao CRM")
      (try (ws-broadcast "crm" (event-json "presence" "Um novo vendedor conectou-se"))))
    (on-message text
      (try (ws-broadcast "crm" (event-json "sync" text))))
    (on-close
      (println "Vendedor desconectado")
      (try (ws-broadcast "crm" (event-json "presence" "Um vendedor desconectou-se")))))

  ;; --- Ponto de Entrada Principal ---
  (fn main (params) (returns void) (effects db fs io net)
    (body
      (match (init-db)
        (ok inited (println "SQLite do CRM inicializado com sucesso"))
        (err err (println (concat "Falha ao inicializar SQLite: " err))))
      (let port str "7070")
      (match (list-get (args) 0)
        (ok p (set port p))
        (err ignored (set port "7070")))
      (println (concat "LIAF Enterprise CRM rodando na porta " port))
      (match (serve-hybrid "./public" port)
        (ok stopped (println "Servidor encerrado"))
        (err message (println message)))))
)
