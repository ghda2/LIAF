;; std/cookie - Emissao e remocao segura de cookies HTTP
;;
;;   (import "std/cookie")
;;   (let cookie str (cookie-make "session" sid 86400 "/" true true "Lax"))
;;   (return (response-set-cookie res cookie))
;;
(module cookie
  ;; cookie-make formata a diretiva Set-Cookie com atributos recomendados de seguranca.
  ;; same-site pode ser "Lax", "Strict" ou "None".
  (fn cookie-make (params (name str) (value str) (max-age int) (path str) (secure bool) (http-only bool) (same-site str)) (returns str) (effects)
    (body
      (let base str (fmt "{}={}; Path={}; Max-Age={}" name value path max-age))
      (if http-only
        (then (set base (concat base "; HttpOnly"))))
      (if secure
        (then (set base (concat base "; Secure"))))
      (if (not (str-eq same-site ""))
        (then (set base (fmt "{}; SameSite={}" base same-site))))
      (return base)))

  ;; cookie-expire gera diretiva Set-Cookie com Max-Age=0 para remocao no cliente.
  (fn cookie-expire (params (name str) (path str)) (returns str) (effects)
    (body
      (return (fmt "{}=; Path={}; Max-Age=0; HttpOnly; SameSite=Lax" name path))))

  ;; response-set-cookie acrescenta um cookie na resposta sem sobrescrever cookies existentes.
  (fn response-set-cookie (params (res Response) (cookie-str str)) (returns Response) (effects)
    (body
      (return (response-add-header res "Set-Cookie" cookie-str))))

  ;; response-delete-cookie instrui o navegador a apagar o cookie especificado.
  (fn response-delete-cookie (params (res Response) (name str) (path str)) (returns Response) (effects)
    (body
      (return (response-set-cookie res (cookie-expire name path)))))
)
